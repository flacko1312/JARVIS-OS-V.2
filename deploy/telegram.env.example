# Copy to ~/.config/jarvis/telegram.env, chmod 600, then insert real values.
# Never commit the resulting telegram.env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_REQUEST_TIMEOUT=135
TELEGRAM_LOG_LEVEL=INFO
TELEGRAM_STATE_DIR=/home/flako1312/.local/state/jarvis-telegram
JARVIS_TEXT_SOCKET=/run/user/1000/jarvis-text.sock
