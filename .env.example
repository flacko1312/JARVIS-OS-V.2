# JARVIS Headless — required environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Required: Gemini API key
GEMINI_API_KEY=

# Optional: LILITH integration (server-lilith runs on localhost:8000)
LILITH_API_URL=http://127.0.0.1:8000
LILITH_API_KEY=

# Optional: XDG_RUNTIME_DIR for PulseAudio (needed when audio is enabled)
# XDG_RUNTIME_DIR=/run/user/1000
